android_app {
    name: "KProfiles",
    init_rc: ["init/init.kprofiles.rc"],
    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: [
        "src/**/*.kt",
        "src/**/*.java"
    ],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
    ],

    required: [
        "privapp_whitelist_com.android.kprofiles.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.android.kprofiles.xml",
    src: "permissions/privapp_whitelist_com.android.kprofiles.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
